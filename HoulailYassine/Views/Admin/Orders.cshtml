@model List<Commande>

@{
    ViewData["Title"] = "Orders Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Orders Management</h2>
        <a asp-action="Index" asp-controller="Admin" class="btn btn-secondary">
            ← Back to Dashboard
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Order ID</th>
                        <th>Order Number</th>
                        <th>Client ID</th>
                        <th>Delivery Address</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.Id</td>
                            <td>@order.Numero</td>
                            <td>@order.ClientId</td>
                            <td>@order.Adresse</td>
                            <td>@order.Montant.ToString("C")</td>
                            <td>
                                @switch (order.Statut)
                                {
                                    case HoulailYassine.Shared.StatutCommande.EnPreparation:
                                        <span class="badge bg-warning">In Preparation</span>
                                        break;
                                    case HoulailYassine.Shared.StatutCommande.EnCoursDeLivraison:
                                        <span class="badge bg-info">In Delivery</span>
                                        break;
                                    case HoulailYassine.Shared.StatutCommande.Livree:
                                        <span class="badge bg-success">Delivered</span>
                                        break;
                                    case HoulailYassine.Shared.StatutCommande.Annulee:
                                        <span class="badge bg-danger">Cancelled</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@order.Statut</span>
                                        break;
                                }
                            </td>
                            <td>@order.CreateAt.ToString("MM/dd/yyyy")</td>
                            <td>
                                <a asp-action="OrderDetail" asp-controller="Admin" asp-route-id="@order.Id" class="btn btn-sm btn-info">
                                    👁️ View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4>No orders found</h4>
            <p>No orders have been placed yet.</p>
        </div>
    }
</div>
