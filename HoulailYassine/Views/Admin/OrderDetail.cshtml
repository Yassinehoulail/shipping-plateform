@model Commande

@{
    ViewData["Title"] = "Order Details";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card shadow-lg">
                <div class="card-header bg-info text-white">
                    <h3 class="mb-0">Order Details</h3>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <h5>Order Information</h5>
                            <table class="table table-bordered">
                                <tr>
                                    <th>Order ID:</th>
                                    <td>@Model.Id</td>
                                </tr>
                                <tr>
                                    <th>Order Number:</th>
                                    <td>@Model.Numero</td>
                                </tr>
                                <tr>
                                    <th>Client ID:</th>
                                    <td>@Model.ClientId</td>
                                </tr>
                                <tr>
                                    <th>Livreur ID:</th>
                                    <td>@Model.LivreurId</td>
                                </tr>
                                <tr>
                                    <th>Amount:</th>
                                    <td><strong>@Model.Montant.ToString("C")</strong></td>
                                </tr>
                                <tr>
                                    <th>Status:</th>
                                    <td>
                                        @switch (Model.Statut)
                                        {
                                            case HoulailYassine.Shared.StatutCommande.EnPreparation:
                                                <span class="badge bg-warning">In Preparation</span>
                                                break;
                                            case HoulailYassine.Shared.StatutCommande.EnCoursDeLivraison:
                                                <span class="badge bg-info">In Delivery</span>
                                                break;
                                            case HoulailYassine.Shared.StatutCommande.Livree:
                                                <span class="badge bg-success">Delivered</span>
                                                break;
                                            case HoulailYassine.Shared.StatutCommande.Annulee:
                                                <span class="badge bg-danger">Cancelled</span>
                                                break;
                                            default:
                                                <span class="badge bg-secondary">@Model.Statut</span>
                                                break;
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th>Created At:</th>
                                    <td>@Model.CreateAt.ToString("MM/dd/yyyy HH:mm")</td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h5>Client Information</h5>
                            <table class="table table-bordered">
                                <tr>
                                    <th>Client Name:</th>
                                    <td>@ViewBag.ClientName</td>
                                </tr>
                                <tr>
                                    <th>Client Email:</th>
                                    <td>@ViewBag.ClientEmail</td>
                                </tr>
                            </table>
                            <h5 class="mt-3">Delivery Information</h5>
                            <div class="card">
                                <div class="card-body">
                                    <p><strong>Delivery Address:</strong></p>
                                    <p>@Model.Adresse</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-12">
                            <h5>Update Order Status</h5>
                            <form asp-action="UpdateOrderStatus" asp-controller="Admin" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="btn-group" role="group">
                                    <button type="submit" name="status" value="@HoulailYassine.Shared.StatutCommande.EnPreparation" 
                                            class="btn btn-warning @(Model.Statut == HoulailYassine.Shared.StatutCommande.EnPreparation ? "active" : "")">
                                        In Preparation
                                    </button>
                                    <button type="submit" name="status" value="@HoulailYassine.Shared.StatutCommande.EnCoursDeLivraison" 
                                            class="btn btn-info @(Model.Statut == HoulailYassine.Shared.StatutCommande.EnCoursDeLivraison ? "active" : "")">
                                        In Delivery
                                    </button>
                                    <button type="submit" name="status" value="@HoulailYassine.Shared.StatutCommande.Livree" 
                                            class="btn btn-success @(Model.Statut == HoulailYassine.Shared.StatutCommande.Livree ? "active" : "")">
                                        Delivered
                                    </button>
                                    <button type="submit" name="status" value="@HoulailYassine.Shared.StatutCommande.Annulee" 
                                            class="btn btn-danger @(Model.Statut == HoulailYassine.Shared.StatutCommande.Annulee ? "active" : "")">
                                        Cancelled
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <a asp-action="Orders" asp-controller="Admin" class="btn btn-secondary">
                            ← Back to Orders
                        </a>
                        <a asp-action="Index" asp-controller="Admin" class="btn btn-primary">
                            🏠 Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
