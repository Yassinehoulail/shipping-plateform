@model AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Admin Dashboard</h2>
        <span class="text-muted">Welcome, @Context.Session.GetString("UserName")</span>
    </div>

    <!-- Statistics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Total Clients</h6>
                            <h2 class="mb-0">@Model.TotalClients</h2>
                        </div>
                        <span style="font-size: 2rem;">👥</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Total Products</h6>
                            <h2 class="mb-0">@Model.TotalProducts</h2>
                        </div>
                        <span style="font-size: 2rem;">📦</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Active Products</h6>
                            <h2 class="mb-0">@Model.ActiveProducts</h2>
                        </div>
                        <span style="font-size: 2rem;">✅</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 mb-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="card-title mb-0">Total Orders</h6>
                            <h2 class="mb-0">@Model.TotalOrders</h2>
                        </div>
                        <span style="font-size: 2rem;">🛒</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Products Management</h5>
                    <p class="card-text">Manage your products: add, edit, or delete products.</p>
                    <a asp-action="Products" asp-controller="Admin" class="btn btn-primary">Manage Products</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Clients Management</h5>
                    <p class="card-text">View and manage all registered clients.</p>
                    <a asp-action="Clients" asp-controller="Admin" class="btn btn-primary">Manage Clients</a>
                </div>
            </div>
        </div>
        <div class="col-md-4 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">Orders Management</h5>
                    <p class="card-text">View and track all customer orders.</p>
                    <a asp-action="Orders" asp-controller="Admin" class="btn btn-primary">Manage Orders</a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .opacity-50 {
        opacity: 0.5;
    }
</style>
