@model List<Produit>

@{
    ViewData["Title"] = "Products Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Products Management</h2>
            <a asp-action="CreateProduct" asp-controller="Admin" class="btn btn-primary">
                ➕ Add New Product
            </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Stock</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr>
                            <td>@product.Id</td>
                            <td>@product.Titre</td>
                            <td>@(product.Description?.Length > 50 ? product.Description.Substring(0, 50) + "..." : product.Description)</td>
                            <td>@product.Prix.ToString("C")</td>
                            <td>
                                @if (product.Stock)
                                {
                                    <span class="badge bg-success">In Stock</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Out of Stock</span>
                                }
                            </td>
                            <td>@product.CreateAt.ToString("MM/dd/yyyy")</td>
                            <td>
                                <a asp-action="EditProduct" asp-controller="Admin" asp-route-id="@product.Id" class="btn btn-sm btn-warning">
                                    ✏️ Edit
                                </a>
                                <form asp-action="DeleteProduct" asp-controller="Admin" asp-route-id="@product.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        🗑️ Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4>No products found</h4>
            <p>Start by adding your first product.</p>
            <a asp-action="CreateProduct" asp-controller="Admin" class="btn btn-primary">Add Product</a>
        </div>
    }
</div>
