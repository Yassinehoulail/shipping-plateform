@model List<Client>

@{
    ViewData["Title"] = "Clients Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Clients Management</h2>
        <a asp-action="Index" asp-controller="Admin" class="btn btn-secondary">
            ← Back to Dashboard
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Address</th>
                        <th>Is Admin</th>
                        <th>Created At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model.Where(c => !c.IsDelete))
                    {
                        <tr>
                            <td>@client.Id</td>
                            <td>@client.Nom @client.Prenom</td>
                            <td>@client.Email</td>
                            <td>@client.Telephone</td>
                            <td>@(client.Adresse ?? "N/A")</td>
                            <td>
                                @if (client.IsAdmin)
                                {
                                    <span class="badge bg-danger">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Client</span>
                                }
                            </td>
                            <td>@client.CreateAt.ToString("MM/dd/yyyy")</td>
                            <td>
                                <form asp-action="DeleteClient" asp-controller="Admin" asp-route-id="@client.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this client?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">
                                        🗑️ Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4>No clients found</h4>
            <p>No clients have registered yet.</p>
        </div>
    }
</div>
