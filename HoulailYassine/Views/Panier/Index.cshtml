@model List<HoulailYassine.Models.ItemPanier>

<h2>Mon Panier</h2>

@if (Model.Count == 0)
{
    <p>Votre panier est vide.</p>
    <a asp-controller="Produit" asp-action="Index">Retour aux produits</a>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Produit</th>
                <th>Prix</th>
                <th>Quantité</th>
                <th>Total</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Titre</td>
                    <td>@item.Prix €</td>
                    <td>@item.Quantite</td>
                    <td>@(item.Prix* item.Quantite) €</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="3" class="text-right"><strong>Total :</strong></td>
                <td><strong>@Model.Sum(x => x.Prix * x.Quantite) €</strong></td>
            </tr>
        </tfoot>
    </table>

    <form asp-action="ValiderCommande" method="post">
        <button type="submit" class="btn btn-success">Passer la commande</button>
        <a asp-controller="Panier" asp-action="Vider" class="btn btn-danger">Vider</a>
    </form>
}