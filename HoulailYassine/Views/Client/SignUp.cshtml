@model CreationClientViewModel

@{
    ViewData["Title"] = "Sign Up";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-body p-5">
                    <h2 class="card-title text-center mb-4">Create Account</h2>
                    
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@error.ErrorMessage</div>
                            }
                        </div>
                    }

                    <form asp-action="SignUp" asp-controller="Client" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Nom" class="form-label">First Name <span class="text-danger">*</span></label>
                                <input asp-for="Nom" class="form-control" placeholder="Enter your first name" />
                                <span asp-validation-for="Nom" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Prenom" class="form-label">Last Name</label>
                                <input asp-for="Prenom" class="form-control" placeholder="Enter your last name" />
                                <span asp-validation-for="Prenom" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NumdeTelephone" class="form-label">Phone Number</label>
                            <input asp-for="NumdeTelephone" class="form-control" placeholder="Enter your phone number" />
                            <span asp-validation-for="NumdeTelephone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="EMail" class="form-label">Email <span class="text-danger">*</span></label>
                            <input asp-for="EMail" type="email" class="form-control" placeholder="Enter your email" />
                            <span asp-validation-for="EMail" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MotPasse" class="form-label">Password <span class="text-danger">*</span></label>
                            <input asp-for="MotPasse" class="form-control" placeholder="Enter your password" />
                            <span asp-validation-for="MotPasse" class="text-danger"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg">Sign Up</button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <p>Already have an account? <a asp-action="Login" asp-controller="Client">Login here</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
