@model List<Commande>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container mt-4">
    <h2>My Orders</h2>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Order Number</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Delivery Address</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td>@order.Numero</td>
                            <td>@order.CreateAt.ToString("MM/dd/yyyy")</td>
                            <td>@order.Montant.ToString("C")</td>
                            <td>
                                @switch (order.Statut)
                                {
                                    case HoulailYassine.Shared.StatutCommande.EnPreparation:
                                        <span class="badge bg-warning">In Preparation</span>
                                        break;
                                    case HoulailYassine.Shared.StatutCommande.EnCoursDeLivraison:
                                        <span class="badge bg-info">In Delivery</span>
                                        break;
                                    case HoulailYassine.Shared.StatutCommande.Livree:
                                        <span class="badge bg-success">Delivered</span>
                                        break;
                                    case HoulailYassine.Shared.StatutCommande.Annulee:
                                        <span class="badge bg-danger">Cancelled</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">@order.Statut</span>
                                        break;
                                }
                            </td>
                            <td>@order.Adresse</td>
                            <td>
                                <a asp-action="Detail" asp-controller="Commande" asp-route-id="@order.Id" class="btn btn-sm btn-info">
                                    👁️ View Details
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <h4>No orders found</h4>
            <p>You haven't placed any orders yet.</p>
        </div>
    }
</div>
